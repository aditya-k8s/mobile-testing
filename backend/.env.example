# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL=postgresql+asyncpg://family:change-me@localhost:5432/family_monitor
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true
# JSON list of RTCIceServer objects. Add a TURN server for production (see README).
ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
# Optional: Firebase service-account JSON used to push screen-share requests to the child device.
FCM_SERVICE_ACCOUNT_FILE=
